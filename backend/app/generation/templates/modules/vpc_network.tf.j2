module "{{ resource.terraform_resource_name }}" {
  source  = "terraform-google-modules/network/google"
  version = "~> 9.0"

  project_id   = "{{ resource.project }}"
  network_name = "{{ resource.name }}"
  routing_mode = "{{ attrs.routing_mode }}"

  auto_create_subnetworks = {{ attrs.auto_create_subnetworks | lower }}
{% if attrs.mtu and attrs.mtu != 1460 %}
  mtu                     = {{ attrs.mtu }}
{% endif %}
{% if attrs.description %}
  description             = "{{ attrs.description }}"
{% endif %}

{% if attrs.subnets %}
  subnets = [
{% for subnet in attrs.subnets %}
    {
      subnet_name           = "{{ subnet.name }}"
      subnet_ip             = "{{ subnet.ip_cidr_range }}"
      subnet_region         = "{{ subnet.region }}"
{% if subnet.private_ip_google_access %}
      subnet_private_access = "true"
{% endif %}
{% if subnet.purpose and subnet.purpose != "PRIVATE" %}
      purpose               = "{{ subnet.purpose }}"
{% endif %}
    },
{% endfor %}
  ]
{% else %}
  subnets = []
{% endif %}

{% if attrs.secondary_ranges %}
  secondary_ranges = {
{% for subnet_name, ranges in attrs.secondary_ranges.items() %}
    {{ subnet_name }} = [
{% for range in ranges %}
      {
        range_name    = "{{ range.range_name }}"
        ip_cidr_range = "{{ range.ip_cidr_range }}"
      },
{% endfor %}
    ]
{% endfor %}
  }
{% endif %}
}
