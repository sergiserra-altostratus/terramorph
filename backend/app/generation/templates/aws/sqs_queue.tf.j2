# SQS Queue: {{ resource.name }}
resource "aws_sqs_queue" "{{ resource.terraform_resource_name }}" {
  name = "{{ attrs.name }}"
{% if attrs.fifo_queue is not none %}
  fifo_queue = {{ attrs.fifo_queue | lower }}
{% endif %}
{% if attrs.content_based_deduplication is not none %}
  content_based_deduplication = {{ attrs.content_based_deduplication | lower }}
{% endif %}
{% if attrs.delay_seconds is not none %}
  delay_seconds = {{ attrs.delay_seconds }}
{% endif %}
{% if attrs.max_message_size %}
  max_message_size = {{ attrs.max_message_size }}
{% endif %}
{% if attrs.message_retention_seconds %}
  message_retention_seconds = {{ attrs.message_retention_seconds }}
{% endif %}
{% if attrs.receive_wait_time_seconds is not none %}
  receive_wait_time_seconds = {{ attrs.receive_wait_time_seconds }}
{% endif %}
{% if attrs.visibility_timeout_seconds %}
  visibility_timeout_seconds = {{ attrs.visibility_timeout_seconds }}
{% endif %}
{% if attrs.sqs_managed_sse_enabled is not none %}
  sqs_managed_sse_enabled = {{ attrs.sqs_managed_sse_enabled | lower }}
{% endif %}
{% if attrs.kms_master_key_id %}
  kms_master_key_id = "{{ attrs.kms_master_key_id }}"
{% endif %}
{% if attrs.tags %}
  tags = {
{% for key, value in attrs.tags.items() %}
    "{{ key }}" = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
