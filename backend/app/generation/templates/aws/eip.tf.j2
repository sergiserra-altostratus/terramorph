# Elastic IP: {{ resource.name }}
resource "aws_eip" "{{ resource.terraform_resource_name }}" {
{% if attrs.domain %}
  domain = "{{ attrs.domain }}"
{% endif %}
{% if attrs.instance %}
  instance = "{{ attrs.instance }}"
{% endif %}
{% if attrs.network_interface %}
  network_interface = "{{ attrs.network_interface }}"
{% endif %}
{% if attrs.associate_with_private_ip %}
  associate_with_private_ip = "{{ attrs.associate_with_private_ip }}"
{% endif %}
{% if attrs.tags %}
  tags = {
{% for key, value in attrs.tags.items() %}
    "{{ key }}" = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
