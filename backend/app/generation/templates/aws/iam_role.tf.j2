# IAM Role: {{ resource.name }}
resource "aws_iam_role" "{{ resource.terraform_resource_name }}" {
  name = "{{ attrs.name }}"
{% if attrs.path %}
  path = "{{ attrs.path }}"
{% endif %}
{% if attrs.description %}
  description = "{{ attrs.description }}"
{% endif %}
{% if attrs.max_session_duration %}
  max_session_duration = {{ attrs.max_session_duration }}
{% endif %}
{% if attrs.permissions_boundary %}
  permissions_boundary = "{{ attrs.permissions_boundary }}"
{% endif %}
  assume_role_policy = jsonencode({{ attrs.assume_role_policy | default('{}') }})
{% if attrs.managed_policy_arns %}
  managed_policy_arns = [
{% for arn in attrs.managed_policy_arns %}
    "{{ arn }}"{{ "," if not loop.last }}
{% endfor %}
  ]
{% endif %}
{% if attrs.tags %}
  tags = {
{% for key, value in attrs.tags.items() %}
    "{{ key }}" = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
