# SNS Topic: {{ resource.name }}
resource "aws_sns_topic" "{{ resource.terraform_resource_name }}" {
  name = "{{ attrs.name }}"
{% if attrs.display_name %}
  display_name = "{{ attrs.display_name }}"
{% endif %}
{% if attrs.fifo_topic is not none %}
  fifo_topic = {{ attrs.fifo_topic | lower }}
{% endif %}
{% if attrs.content_based_deduplication is not none %}
  content_based_deduplication = {{ attrs.content_based_deduplication | lower }}
{% endif %}
{% if attrs.kms_master_key_id %}
  kms_master_key_id = "{{ attrs.kms_master_key_id }}"
{% endif %}
{% if attrs.tags %}
  tags = {
{% for key, value in attrs.tags.items() %}
    "{{ key }}" = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
