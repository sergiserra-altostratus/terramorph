# Subnet: {{ resource.name }}
resource "aws_subnet" "{{ resource.terraform_resource_name }}" {
  vpc_id     = "{{ attrs.vpc_id }}"
  cidr_block = "{{ attrs.cidr_block }}"
{% if attrs.availability_zone %}
  availability_zone = "{{ attrs.availability_zone }}"
{% endif %}
{% if attrs.map_public_ip_on_launch is not none %}
  map_public_ip_on_launch = {{ attrs.map_public_ip_on_launch | lower }}
{% endif %}
{% if attrs.assign_ipv6_address_on_creation is not none %}
  assign_ipv6_address_on_creation = {{ attrs.assign_ipv6_address_on_creation | lower }}
{% endif %}
{% if attrs.tags %}
  tags = {
{% for key, value in attrs.tags.items() %}
    "{{ key }}" = "{{ value }}"
{% endfor %}
  }
{% endif %}
}
