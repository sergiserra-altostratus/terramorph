resource "google_project" "{{ resource.terraform_resource_name }}" {
  name       = "{{ attrs.name }}"
  project_id = "{{ attrs.project_id }}"
{% if attrs.parent %}
{% if 'folders/' in attrs.parent %}
  folder_id  = "{{ attrs.parent | replace('folders/', '') }}"
{% elif 'organizations/' in attrs.parent %}
  org_id     = "{{ attrs.parent | replace('organizations/', '') }}"
{% endif %}
{% endif %}
{% if attrs.billing_account %}
  billing_account = "{{ attrs.billing_account }}"
{% endif %}

{% if attrs.labels %}
  labels = {
{% for key, value in attrs.labels.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
{% endif %}
}

{% for api in attrs.activate_apis %}
resource "google_project_service" "{{ resource.terraform_resource_name }}_{{ api | replace('.googleapis.com', '') | replace('.', '_') | replace('-', '_') }}" {
  project = "{{ attrs.project_id }}"
  service = "{{ api }}"

  disable_on_destroy = false
}

{% endfor %}
